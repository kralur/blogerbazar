    "MaxTelegramUserPartitions": 200000,
    "TelegramWebhook": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Payments": {
    "ContactUnlockAmountUzs": 29000,
    "ContactUnlockExpiresInMinutes": 30
  },
  "Administration": {
    "TelegramUserIds": []
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "DevelopmentData": {
    "Seed": false
  },
  "AllowedHosts": "*"
}

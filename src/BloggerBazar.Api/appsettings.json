{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Telegram": {
    "WebhookMaxBodyBytes": 65536,
    "MaxInitDataAgeSeconds": 3600,
    "MaxInitDataClockSkewSeconds": 60
  },
  "Click": {
    "Currency": "UZS",
    "CurrencyExponent": 2
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "GlobalConcurrentPermitLimit": 500,
    "GlobalQueueLimit": 100,

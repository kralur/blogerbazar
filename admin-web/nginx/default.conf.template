# Web admin site (admin-web): the static pages, and /api passed to the API over Railway's private network, so the
# browser sees one origin: the session cookie stays first-party (HttpOnly, SameSite=Strict) and no CORS is needed.
# ${...} values come from the environment when the container starts (nginx image templates):
#   PORT                    the port Railway routes to;
#   API_UPSTREAM            the API on the private network, e.g. http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080;
#   NGINX_LOCAL_RESOLVERS   the container's DNS servers (set by the image from /etc/resolv.conf).

# No query strings, addresses or user agents in the access log: the sign-in return address carries Telegram data.
log_format admin_web '$time_iso8601 "$request_method $uri" $status $body_bytes_sent $request_time';

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /var/log/nginx/access.log admin_web;
    client_max_body_size 1m;
    # Looked up per request (not once at start), so the API can move inside the private network.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Only the admin part of the API is reachable from this site (/api/admin*, /api/admin-web/*, also under /api/v1);
    # the marketplace API stays on its own address.
    location /api/ {
        return 404;
    }

    location ~ ^/api/(v1/)?admin(-web)?(/|$) {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Railway's edge puts the caller's address first; the API reads it for the per-address sign-in limit.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    # The sign-in page: the only document where the Telegram widget script (and its oauth.telegram.org frame) may
    # run. No opener policy here: the widget's confirmation window must be able to answer it.
    location = /login {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self' https://telegram.org; frame-src https://oauth.telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
        try_files /login.html =404;
    }

    location = /login.html {
        return 301 /login$is_args$args;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite names built files by content, so they can be kept for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Every admin page, including the /auth/telegram return page: own scripts and styles only.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; require-trusted-types-for 'script'" always;
        try_files $uri /index.html;
    }
}
